{
  "name": "ddo",
  "displayName": "DuckDuckOps",
  "description": "Terminal-first workstation: terminal with files below it, AI chat on the right.",
  "version": "0.5.0",
  "publisher": "ddo",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "terminalDataWriteEvent",
    "terminalSelection"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ddo.focusTerminal",
        "title": "Focus Terminal",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.focusChat",
        "title": "Focus AI Chat",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.clearTerminal",
        "title": "Clear Terminal",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.openLog",
        "title": "Open Log / Text File...",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.toggleTail",
        "title": "Toggle Live Tail (Active File)",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.newTerminalWithProfile",
        "title": "New Terminal with Profile...",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.addProfile",
        "title": "Add Shell Profile...",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.editProfiles",
        "title": "Edit Shell Profiles (settings)",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.runInTerminal",
        "title": "Run Command in Terminal",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.askAboutSelection",
        "title": "Ask Chat About Selection / Log",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.installVsixFolder",
        "title": "Install VSIX Files from Internal Folder",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.resetLayout",
        "title": "Reset Layout (Terminal + Chat Right)",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.setupAgents",
        "title": "Set Up Agents",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.sessions.quickConnect",
        "title": "Quick Connect...",
        "category": "DuckDuckOps",
        "icon": "$(zap)"
      },
      {
        "command": "ddo.sessions.new",
        "title": "New Session...",
        "category": "DuckDuckOps",
        "icon": "$(add)"
      },
      {
        "command": "ddo.sessions.import",
        "title": "Import Sessions (MobaXterm, PuTTY, SSH Config)...",
        "category": "DuckDuckOps",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ddo.sessions.openFile",
        "title": "Open Sessions File",
        "category": "DuckDuckOps",
        "icon": "$(json)"
      },
      {
        "command": "ddo.sessions.openLogs",
        "title": "Open Session Logs Folder",
        "category": "DuckDuckOps",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ddo.sessions.refresh",
        "title": "Refresh Sessions",
        "category": "DuckDuckOps",
        "icon": "$(refresh)"
      },
      {
        "command": "ddo.sessions.connect",
        "title": "Connect",
        "category": "DuckDuckOps",
        "icon": "$(play)"
      },
      {
        "command": "ddo.sessions.stopTunnel",
        "title": "Stop Tunnel",
        "category": "DuckDuckOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ddo.sessions.edit",
        "title": "Edit Session",
        "category": "DuckDuckOps",
        "icon": "$(edit)"
      },
      {
        "command": "ddo.sessions.duplicate",
        "title": "Duplicate Session",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.sessions.copyCommand",
        "title": "Copy SSH Command",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.sessions.delete",
        "title": "Delete Session",
        "category": "DuckDuckOps",
        "icon": "$(trash)"
      },
      {
        "command": "ddo.recommendedExtensions",
        "title": "Recommended Extensions for Ops...",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.checkForUpdates",
        "title": "Check for Updates...",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.sessions.copyToSaved",
        "title": "Copy to My Sessions",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.askAboutFailure",
        "title": "Ask the Duck About the Failed Command",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.askAboutTerminalSelection",
        "title": "Ask the Duck",
        "category": "DuckDuckOps"
      },
      {
        "command": "ddo.saveSummary",
        "title": "Open Summary as Markdown",
        "category": "DuckDuckOps"
      }
    ],
    "keybindings": [
      {
        "command": "ddo.focusTerminal",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "ddo.focusChat",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "ddo.openLog",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "ddo.clearTerminal",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "ddo.toggleTail",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "ddo.newTerminalWithProfile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "ddo.askAboutSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "themes": [
      {
        "id": "Forge Light",
        "label": "Forge Light",
        "uiTheme": "vs",
        "path": "./themes/forge-light-color-theme.json"
      },
      {
        "id": "Forge Dark",
        "label": "Forge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/forge-dark-color-theme.json"
      }
    ],
    "chatParticipants": [
      {
        "id": "ddo.duck",
        "name": "duck",
        "fullName": "Duck",
        "description": "Your rubber duck for the terminal (reads its recent output)",
        "isSticky": true,
        "commands": [
          {
            "name": "rubberduck",
            "description": "Talk a problem through: the duck asks questions until you find the cause"
          },
          {
            "name": "explain",
            "description": "Explain the last terminal output / error"
          },
          {
            "name": "fix",
            "description": "Suggest commands to fix the last failure"
          },
          {
            "name": "logs",
            "description": "Analyze the active log file (errors, patterns, timeline)"
          },
          {
            "name": "summary",
            "description": "Sum up this terminal session as an incident report (timeline, cause, changes, open points)"
          }
        ]
      }
    ],
    "configuration": {
      "title": "DuckDuckOps",
      "properties": {
        "ddo.profiles": {
          "type": "array",
          "markdownDescription": "Custom shell profiles. Each: `name`, `path`, optional `args`, `env`, `cwd`. See `examples/profiles.json`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "ddo.defaultProfile": {
          "type": "string",
          "default": "",
          "description": "Name of the profile used for the terminal opened at startup. Empty = system default shell."
        },
        "ddo.systemPrompt": {
          "type": "string",
          "default": "You are the duck of DuckDuckOps, an operations assistant next to the user's terminal. You are NOT a coding assistant. Focus on shell usage, system administration, troubleshooting and log analysis. Be calm and concise, no jokes. When you suggest commands, put each in its own fenced ```sh block, one command (or pipeline) per block, and explain risks before anything destructive. Prefer read-only diagnostics first. Reference the supplied terminal output and log excerpts when reasoning.",
          "editPresentation": "multilineText",
          "description": "System instructions for the @duck chat participant."
        },
        "ddo.chat.terminalContextChars": {
          "type": "number",
          "default": 8000,
          "description": "Max characters of recent terminal output sent to the chat."
        },
        "ddo.chat.confirmBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before running a chat-suggested command."
        },
        "ddo.chat.askOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "When a terminal command fails, show \"Ask the duck\" in the status bar for two minutes."
        },
        "ddo.logs.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Reveal newly created .log/.txt files (created or modified by terminal commands) in the main area."
        },
        "ddo.logs.autoTail": {
          "type": "boolean",
          "default": true,
          "description": "Enable live tail (follow end of file) automatically for .log files."
        },
        "ddo.logs.maxAnalyzeChars": {
          "type": "number",
          "default": 24000,
          "description": "Max characters of a log (tail) sent to the chat for /logs."
        },
        "ddo.extensions.vsixFolder": {
          "type": "string",
          "default": "",
          "description": "Folder with internal .vsix files, installed by 'Install VSIX Files from Internal Folder'."
        },
        "ddo.sessions.file": {
          "type": "string",
          "default": "~/.ddo/sessions.json",
          "description": "File with the saved sessions."
        },
        "ddo.sessions.teamFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Read-only session files shared by a team (for example on a network share), each shown as a group in the Sessions list. Same format as `ddo.sessions.file`."
        },
        "ddo.sessions.listFrom": {
          "type": "array",
          "items": {
            "enum": [
              "sshconfig",
              "mobaxterm",
              "putty"
            ],
            "enumDescriptions": [
              "Hosts of ~/.ssh/config",
              "Sessions of MobaXterm (MobaXterm.ini)",
              "Saved sessions of PuTTY"
            ]
          },
          "default": [
            "sshconfig",
            "mobaxterm",
            "putty"
          ],
          "uniqueItems": true,
          "description": "Where else sessions are listed from, live and read-only, next to your own sessions."
        },
        "ddo.sessions.mobaXtermFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "MobaXterm's settings file (`MobaXterm.ini`), for example of a portable MobaXterm. Empty: the file of the installed MobaXterm, if there is one."
        },
        "ddo.sessions.sshPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `ssh` program. Empty: Windows' own OpenSSH client (`C:\\Windows\\System32\\OpenSSH\\ssh.exe`)."
        },
        "ddo.sessions.logOutput": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Save the output of every session to a log file in `ddo.sessions.logFolder`. A session can also turn it on for itself (`\"log\": true`)."
        },
        "ddo.sessions.logFolder": {
          "type": "string",
          "default": "~/.ddo/logs",
          "description": "Folder for session log files, one sub folder per session."
        },
        "ddo.sessions.colorStyle": {
          "type": "string",
          "enum": [
            "border",
            "background",
            "none"
          ],
          "enumDescriptions": [
            "A border in the session's colour around its terminal.",
            "The terminal's background tinted with the session's colour.",
            "Only the terminal tab icon has the session's colour."
          ],
          "default": "border",
          "description": "How a session terminal shows the session's colour (random for new sessions, red for production)."
        },
        "ddo.sessions.rememberTypedSsh": {
          "type": "boolean",
          "default": true,
          "description": "Save ssh commands typed in a terminal as sessions under Recent."
        },
        "ddo.terminal.defaultShell": {
          "type": "string",
          "enum": [
            "auto",
            "wsl",
            "powershell",
            "cmd",
            "manual"
          ],
          "enumDescriptions": [
            "WSL when a distribution is installed, otherwise PowerShell 7, otherwise Windows PowerShell.",
            "The default WSL distribution.",
            "PowerShell 7 when installed, otherwise Windows PowerShell.",
            "Command Prompt.",
            "Leave terminal.integrated.defaultProfile.windows as it is."
          ],
          "default": "auto",
          "description": "The shell of new terminals on Windows. A default terminal profile you chose yourself is kept."
        },
        "ddo.updates.check": {
          "type": "boolean",
          "default": true,
          "description": "Look for a newer DuckDuckOps release on GitHub once a day."
        },
        "ddo.updates.repository": {
          "type": "string",
          "default": "acathon/duckduckops-terminal",
          "description": "The GitHub repository (owner/name) whose releases the update check looks at."
        }
      }
    },
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.editor.empty.hint": "hidden",
      "workbench.tips.enabled": false,
      "window.commandCenter": false,
      "breadcrumbs.enabled": false,
      "update.showReleaseNotes": false,
      "terminal.integrated.defaultLocation": "view",
      "terminal.integrated.shellIntegration.enabled": true,
      "terminal.integrated.scrollback": 20000,
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.cursorBlinking": true,
      "terminal.integrated.enablePersistentSessions": true,
      "files.autoSave": "off",
      "[log]": {
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        "editor.folding": false,
        "editor.glyphMargin": false,
        "editor.lineNumbers": "on",
        "editor.renderLineHighlight": "none",
        "editor.stickyScroll.enabled": false,
        "editor.scrollBeyondLastLine": false,
        "editor.occurrencesHighlight": "off",
        "editor.codeLens": false,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        }
      },
      "[plaintext]": {
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        "editor.folding": false,
        "editor.glyphMargin": false,
        "editor.lineNumbers": "on",
        "editor.renderLineHighlight": "none",
        "editor.stickyScroll.enabled": false,
        "editor.scrollBeyondLastLine": false
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ddo-sessions",
          "title": "Sessions",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "ddo-sessions": [
        {
          "id": "ddo.sessions",
          "name": "Sessions",
          "icon": "media/sessions.svg",
          "contextualTitle": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ddo.sessions",
        "contents": "Save your servers once and connect with a click: SSH with jump host, SOCKS5 or HTTP proxy and port forwarding, SSH tunnels, Remote Desktop and local shells.\n[Quick Connect](command:ddo.sessions.quickConnect)\n[New Session](command:ddo.sessions.new)\nComing from MobaXterm or PuTTY?\n[Import Sessions](command:ddo.sessions.import)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ddo.sessions.quickConnect",
          "when": "view == ddo.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ddo.sessions.new",
          "when": "view == ddo.sessions",
          "group": "navigation@2"
        },
        {
          "command": "ddo.sessions.import",
          "when": "view == ddo.sessions",
          "group": "navigation@3"
        },
        {
          "command": "ddo.sessions.refresh",
          "when": "view == ddo.sessions",
          "group": "navigation@4"
        },
        {
          "command": "ddo.sessions.openFile",
          "when": "view == ddo.sessions",
          "group": "1_files@1"
        },
        {
          "command": "ddo.sessions.openLogs",
          "when": "view == ddo.sessions",
          "group": "1_files@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ddo.sessions.connect",
          "when": "view == ddo.sessions && viewItem =~ /^session\\.(ssh|rdp|shell|tunnel(?!\\.running))/",
          "group": "inline@1"
        },
        {
          "command": "ddo.sessions.stopTunnel",
          "when": "view == ddo.sessions && viewItem =~ /^session\\.tunnel\\.running/",
          "group": "inline@1"
        },
        {
          "command": "ddo.sessions.connect",
          "when": "view == ddo.sessions && viewItem =~ /^session\\.(ssh|rdp|shell|tunnel(?!\\.running))/",
          "group": "1_connect@1"
        },
        {
          "command": "ddo.sessions.stopTunnel",
          "when": "view == ddo.sessions && viewItem =~ /^session\\.tunnel\\.running/",
          "group": "1_connect@1"
        },
        {
          "command": "ddo.sessions.copyCommand",
          "when": "view == ddo.sessions && viewItem =~ /^session\\.(ssh|tunnel)/",
          "group": "2_copy@1"
        },
        {
          "command": "ddo.sessions.edit",
          "when": "view == ddo.sessions && viewItem =~ /^session\\./ && viewItem =~ /^(?!.*readonly)/",
          "group": "3_edit@1"
        },
        {
          "command": "ddo.sessions.duplicate",
          "when": "view == ddo.sessions && viewItem =~ /^session\\./ && viewItem =~ /^(?!.*readonly)/",
          "group": "3_edit@2"
        },
        {
          "command": "ddo.sessions.delete",
          "when": "view == ddo.sessions && viewItem =~ /^session\\./ && viewItem =~ /^(?!.*readonly)/",
          "group": "4_delete@1"
        },
        {
          "command": "ddo.sessions.copyToSaved",
          "when": "view == ddo.sessions && viewItem =~ /^session\\..*readonly/",
          "group": "3_edit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ddo.sessions.connect",
          "when": "false"
        },
        {
          "command": "ddo.sessions.stopTunnel",
          "when": "false"
        },
        {
          "command": "ddo.sessions.edit",
          "when": "false"
        },
        {
          "command": "ddo.sessions.duplicate",
          "when": "false"
        },
        {
          "command": "ddo.sessions.copyCommand",
          "when": "false"
        },
        {
          "command": "ddo.sessions.delete",
          "when": "false"
        },
        {
          "command": "ddo.sessions.copyToSaved",
          "when": "false"
        },
        {
          "command": "ddo.askAboutTerminalSelection",
          "when": "terminalTextSelected"
        },
        {
          "command": "ddo.saveSummary",
          "when": "false"
        }
      ],
      "terminal/context": [
        {
          "command": "ddo.askAboutTerminalSelection",
          "when": "terminalTextSelected",
          "group": "0_ddo@1"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.ddo/sessions.json",
        "url": "./schemas/sessions.schema.json"
      }
    ]
  }
}
