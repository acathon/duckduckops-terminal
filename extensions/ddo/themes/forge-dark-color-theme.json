	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#7A7E85", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.logical.python", "keyword.operator.new", "keyword.operator.expression", "keyword.other"],
			"settings": { "foreground": "#CF8E6D" }
		},
		{
			"scope": ["keyword.operator", "punctuation"],
			"settings": { "foreground": "#BCBEC4" }
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": { "foreground": "#6AAB73" }
		},
		{
			"scope": "string.quoted.docstring",
			"settings": { "foreground": "#5F826B", "fontStyle": "italic" }
		},
		{
			"scope": ["constant.character.escape", "string.regexp constant.character.escape"],
			"settings": { "foreground": "#CF8E6D" }
		},
		{
			"scope": "constant.numeric",
			"settings": { "foreground": "#2AACB8" }
		},
		{
			"scope": ["constant.language", "variable.language.this", "support.constant"],
			"settings": { "foreground": "#CF8E6D" }
		},
		{
			"scope": ["variable.language.self", "variable.parameter.function.language.special.self"],
			"settings": { "foreground": "#94558D" }
		},
		{
			"scope": ["variable.other.constant", "variable.other.enummember", "entity.name.constant", "variable.other.property", "variable.other.object.property", "meta.property-name"],
			"settings": { "foreground": "#C77DBB" }
		},
		{
			"scope": ["entity.name.function", "meta.definition.method entity.name.function"],
			"settings": { "foreground": "#56A8F5" }
		},
		{
			"scope": ["support.function", "support.function.builtin", "support.type.builtin"],
			"settings": { "foreground": "#8888C6" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#BCBEC4" }
		},
		{
			"scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator", "storage.type.annotation"],
			"settings": { "foreground": "#B3AE60" }
		},
		{
			"scope": ["entity.name.tag", "entity.name.tag.yaml"],
			"settings": { "foreground": "#D5B778" }
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": { "foreground": "#BABABA" }
		},
		{
			"scope": ["support.type.property-name.json", "support.type.property-name"],
			"settings": { "foreground": "#C77DBB" }
		},
		{
			"scope": ["variable.other.normal.shell", "variable.other.bracket.shell", "punctuation.definition.variable.shell", "variable.other.readwrite.powershell", "punctuation.definition.variable.powershell"],
			"settings": { "foreground": "#C77DBB" }
		},
		{
			"scope": ["entity.name.command.shell", "support.function.builtin.shell"],
			"settings": { "foreground": "#8888C6" }
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": { "foreground": "#CF8E6D", "fontStyle": "bold" }
		},
		{
			"scope": "markup.bold",
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": "markup.italic",
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": "markup.underline",
			"settings": { "fontStyle": "underline" }
		},
		{
			"scope": "markup.strikethrough",
			"settings": { "fontStyle": "strikethrough" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#6AAB73" }
		},
		{
			"scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
			"settings": { "foreground": "#6AAB73" }
		},
		{
			"scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
			"settings": { "foreground": "#F75464" }
		},
		{
			"scope": ["markup.changed", "punctuation.definition.changed"],
			"settings": { "foreground": "#56A8F5" }
		},
		{
			"scope": ["meta.diff.range", "meta.diff.header"],
			"settings": { "foreground": "#7A7E85", "fontStyle": "italic" }
		},
		{
			"scope": ["invalid", "invalid.illegal", "invalid.broken", "invalid.deprecated", "invalid.unimplemented"],
			"settings": { "foreground": "#F75464", "fontStyle": "italic" }
		},
		{
			"scope": ["log.date", "log.verbose"],
			"settings": { "foreground": "#7A7E85", "fontStyle": "" }
		},
		{
			"scope": "log.debug",
			"settings": { "foreground": "#868A91" }
		},
		{
			"scope": "log.info",
			"settings": { "foreground": "#56A8F5" }
		},
		{
			"scope": "log.warning",
			"settings": { "foreground": "#E0B95C", "fontStyle": "bold" }
		},
		{
			"scope": "log.error",
			"settings": { "foreground": "#F75464", "fontStyle": "bold" }
		},
		{
			"scope": ["log.exception", "log.exceptiontype"],
			"settings": { "foreground": "#F75464" }
		},
		{
			"scope": "log.string",
			"settings": { "foreground": "#6AAB73" }
		},
		{
			"scope": "log.constant",
			"settings": { "foreground": "#2AACB8" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function.declaration": "#56A8F5",
		"method.declaration": "#56A8F5",
		"parameter": "#BCBEC4",
		"property": "#C77DBB",
		"enumMember": "#C77DBB",
		"selfParameter": "#94558D",
		"decorator": "#B3AE60"
	}
}
