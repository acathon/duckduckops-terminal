	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#6B8F72",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.logical.python",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.other"
			],
			"settings": {
				"foreground": "#0A6E3A"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#031A08"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"string.quoted.docstring"
			],
			"settings": {
				"foreground": "#5C7A00"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.regexp constant.character.escape"
			],
			"settings": {
				"foreground": "#066B2C"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#B26B00"
			}
		},
		{
			"scope": [
				"constant.language",
				"variable.language.this",
				"support.constant"
			],
			"settings": {
				"foreground": "#0A6E3A"
			}
		},
		{
			"scope": [
				"variable.language.self",
				"variable.parameter.function.language.special.self"
			],
			"settings": {
				"foreground": "#3E7C17"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"variable.other.enummember",
				"entity.name.constant",
				"variable.other.property",
				"variable.other.object.property",
				"meta.property-name"
			],
			"settings": {
				"foreground": "#00796B"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.definition.method entity.name.function"
			],
			"settings": {
				"foreground": "#006D77"
			}
		},
		{
			"scope": [
				"support.function",
				"support.function.builtin",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#0B4F2A"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#031A08"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.definition.decorator",
				"storage.type.annotation"
			],
			"settings": {
				"foreground": "#8A7300"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#0A6E3A"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#066B2C"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
