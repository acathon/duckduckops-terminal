	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#5A9466",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.logical.python",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.other"
			],
			"settings": {
				"foreground": "#00FFA3"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#A9EBB3"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#B4FF39"
			}
		},
		{
			"scope": "string.quoted.docstring",
			"settings": {
				"foreground": "#4F8A5B",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.regexp constant.character.escape"
			],
			"settings": {
				"foreground": "#00FFA3"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#FFD866"
			}
		},
		{
			"scope": [
				"constant.language",
				"variable.language.this",
				"support.constant"
			],
			"settings": {
				"foreground": "#00FFA3"
			}
		},
		{
			"scope": [
				"variable.language.self",
				"variable.parameter.function.language.special.self"
			],
			"settings": {
				"foreground": "#5FD38D"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"variable.other.enummember",
				"entity.name.constant",
				"variable.other.property",
				"variable.other.object.property",
				"meta.property-name"
			],
			"settings": {
				"foreground": "#7CF0B4"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.definition.method entity.name.function"
			],
			"settings": {
				"foreground": "#4DE8FF"
			}
		},
		{
			"scope": [
				"support.function",
				"support.function.builtin",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#8BE9C9"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#A9EBB3"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.definition.decorator",
				"storage.type.annotation"
			],
			"settings": {
				"foreground": "#D6E85C"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#E6D27A"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#A3E3AD"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#7CF0B4"
			}
		},
		{
			"scope": [
				"variable.other.normal.shell",
				"variable.other.bracket.shell",
				"punctuation.definition.variable.shell",
				"variable.other.readwrite.powershell",
				"punctuation.definition.variable.powershell"
			],
			"settings": {
				"foreground": "#7CF0B4"
			}
		},
		{
			"scope": [
				"entity.name.command.shell",
				"support.function.builtin.shell"
			],
			"settings": {
				"foreground": "#8BE9C9"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#00FFA3",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#B4FF39"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#B4FF39"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#FF4D6A"
			}
		},
		{
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#4DE8FF"
			}
		},
		{
			"scope": [
				"meta.diff.range",
				"meta.diff.header"
			],
			"settings": {
				"foreground": "#5A9466",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal",
				"invalid.broken",
				"invalid.deprecated",
				"invalid.unimplemented"
			],
			"settings": {
				"foreground": "#FF4D6A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"log.date",
				"log.verbose"
			],
			"settings": {
				"foreground": "#5A9466",
				"fontStyle": ""
			}
		},
		{
			"scope": "log.debug",
			"settings": {
				"foreground": "#63A872"
			}
		},
		{
			"scope": "log.info",
			"settings": {
				"foreground": "#4DE8FF"
			}
		},
		{
			"scope": "log.warning",
			"settings": {
				"foreground": "#FFC94D",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "log.error",
			"settings": {
				"foreground": "#FF4D6A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"log.exception",
				"log.exceptiontype"
			],
			"settings": {
				"foreground": "#FF4D6A"
			}
		},
		{
			"scope": "log.string",
			"settings": {
				"foreground": "#B4FF39"
			}
		},
		{
			"scope": "log.constant",
			"settings": {
				"foreground": "#FFD866"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function.declaration": "#4DE8FF",
		"method.declaration": "#4DE8FF",
		"parameter": "#A9EBB3",
		"property": "#7CF0B4",
		"enumMember": "#7CF0B4",
		"selfParameter": "#5FD38D",
		"decorator": "#D6E85C"
	}
}
